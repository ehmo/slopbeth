{
  "name": "slopkit",
  "version": "1.4.1",
  "description": "Anti-slop skills for AI agents: slopbeth cleans the shipped writing, slopgent cleans the conversation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ehmo/slopkit.git"
  },
  "bugs": {
    "url": "https://github.com/ehmo/slopkit/issues"
  },
  "homepage": "https://github.com/ehmo/slopkit#readme",
  "keywords": [
    "writing",
    "skill",
    "anti-slop",
    "editing",
    "rewriting",
    "conversation",
    "honesty",
    "benchmark"
